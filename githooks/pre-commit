#!/usr/bin/env bash
set -euo pipefail

# lint staged shell scripts with shellcheck before allowing the commit.
# a file counts as a shell script if it ends in .sh, or its shebang names bash/sh.
files=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
    [[ -f "$f" ]] || continue
    if [[ "$f" == *.sh ]] || head -n1 "$f" 2>/dev/null | grep -qE '^#!.*\b(bash|sh)\b'; then
        echo "$f"
    fi
done)

if [[ -z "$files" ]]; then
    exit 0
fi

if ! command -v shellcheck >/dev/null 2>&1; then
    echo "warning: shellcheck not installed, skipping shell lint" >&2
    exit 0
fi

echo "$files" | xargs shellcheck
