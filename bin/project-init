#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: project-init [target-dir]" >&2
    echo "Creates .private-scratch/ files (workspace, note.md, test-list.md, justfile) and .gitignore in target-dir (default: .) from templates/" >&2
    echo "Files that already exist are left untouched and skipped." >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

# resolve symlinks so templates/ is found even when this is symlinked onto PATH
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATES_DIR="$SCRIPT_DIR/../templates"

TARGET_DIR="${1:-.}"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
PROJECT_NAME="$(basename "$TARGET_DIR")"
PRIVATE_DIR="$TARGET_DIR/.private-scratch"

# render a template into dest, substituting {{PROJECT_NAME}}.
# skip (never overwrite) if dest already exists: it may contain manual edits made after generation
render() {
    local template="$1" dest="$2"
    if [[ -e "$dest" ]]; then
        echo "skip: $dest already exists"
        return
    fi
    mkdir -p "$(dirname "$dest")"
    # bash's replacement string treats & as "whole match" (like sed); escape it and \ first
    local escaped_name="${PROJECT_NAME//\\/\\\\}"
    escaped_name="${escaped_name//&/\\&}"
    local content
    content="$(cat "$template")"
    printf '%s\n' "${content//\{\{PROJECT_NAME\}\}/$escaped_name}" > "$dest"
    echo "created $dest"
}

render "$TEMPLATES_DIR/default.code-workspace" "$PRIVATE_DIR/workspace/${PROJECT_NAME}.code-workspace"
render "$TEMPLATES_DIR/note.md" "$PRIVATE_DIR/note.md"
render "$TEMPLATES_DIR/test-list.md" "$PRIVATE_DIR/test-list.md"
render "$TEMPLATES_DIR/justfile" "$PRIVATE_DIR/justfile"
render "$TEMPLATES_DIR/.gitignore" "$TARGET_DIR/.gitignore"
