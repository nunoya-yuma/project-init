{
    "folders": [
        {
            "path": "../"
        }
    ],
    "settings": {
        "terminal.integrated.env.linux": {
            "PATH": "${workspaceFolder}/.private-scratch/scripts:${env:PATH}",
        },
    },
    // Language-specific tasks/launch configs below are starting points.
    // Delete whatever doesn't apply to this project, keep/extend the rest.
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Python: Run current file",
                "type": "shell",
                "command": "python3",
                "args": [
                    "${file}"
                ],
                "problemMatcher": [],
            },
            {
                "label": "Python: pytest",
                "type": "shell",
                "command": "pytest",
                "problemMatcher": [],
            },
            {
                "label": "Bash: shellcheck current file",
                "type": "shell",
                "command": "shellcheck",
                "args": [
                    "${file}"
                ],
                "problemMatcher": [],
            },
            {
                "label": "Bash: run current script (bash -x)",
                "type": "shell",
                "command": "bash",
                "args": [
                    "-x",
                    "${file}"
                ],
                "problemMatcher": [],
            },
            {
                "label": "C: build current file (gcc)",
                "type": "shell",
                "command": "gcc",
                "args": [
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}"
                ],
                "group": {
                    "kind": "build"
                },
                "problemMatcher": [
                    "$gcc"
                ],
            },
            {
                "label": "Rust: cargo build",
                "type": "shell",
                "command": "cargo",
                "args": [
                    "build"
                ],
                "group": {
                    "kind": "build"
                },
                "problemMatcher": [
                    "$rustc"
                ],
            },
            {
                "label": "Rust: cargo run",
                "type": "shell",
                "command": "cargo",
                "args": [
                    "run"
                ],
                "problemMatcher": [
                    "$rustc"
                ],
            },
        ],
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                // requires the ms-python.python extension
                "name": "Python: Debug current file",
                "type": "debugpy",
                "request": "launch",
                "program": "${file}",
                "console": "integratedTerminal",
                "justMyCode": true,
            },
            {
                // requires the ms-vscode.cpptools extension
                "name": "C: Debug current file (gdb)",
                "type": "cppdbg",
                "request": "launch",
                "program": "${fileDirname}/${fileBasenameNoExtension}",
                "args": [],
                "cwd": "${fileDirname}",
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true,
                    },
                ],
                "preLaunchTask": "C: build current file (gcc)",
            },
            {
                // requires the ms-vscode.cpptools extension; for make/CMake projects
                // or any prebuilt binary (build it with -g first). Asks for the path
                // on each launch; to skip the prompt, hard-code "program" and set
                // "preLaunchTask" to the project's build task.
                "name": "C/C++: Debug program (gdb)",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/${input:cProgram}",
                "args": [],
                "cwd": "${workspaceFolder}",
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true,
                    },
                ],
            },
            {
                // requires the vadimcn.vscode-lldb extension; cargo picks the
                // binary, so the package name needn't match the folder name
                "name": "Rust: Debug executable (cargo build)",
                "type": "lldb",
                "request": "launch",
                "cargo": {
                    "args": [
                        "build",
                    ],
                    // a lib+bin package yields two artifacts; keep the binary
                    "filter": {
                        "kind": "bin",
                    },
                },
                "args": [],
                "cwd": "${workspaceFolder}",
            },
        ],
        "inputs": [
            {
                "id": "cProgram",
                "type": "promptString",
                "description": "Executable to debug, relative to the workspace root",
                "default": "build/main",
            },
        ],
    },
}
